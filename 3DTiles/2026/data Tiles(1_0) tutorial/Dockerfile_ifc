# IFC-tools: Python met IfcOpenShell.
# Apart van de workspace-container, omdat IfcOpenShell geen pip-pakket heeft voor
# Alpine (musl). Deze container gebruikt dezelfde map /workspace en dezelfde database.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    ifcopenshell==0.9.0.post1 \
    shapely==2.2.0 \
    numpy==2.5.4 \
    "psycopg[binary]==3.3.8"

# Scripts: ifc_naar_lod.py (opdracht 3) en ifc_naar_glb.py (opdracht 2)
COPY ifc-scripts/*.py /usr/local/bin/
# Windows-regeleinden (CRLF) weghalen, anders faalt de shebang met "python3\r: No such file"
RUN sed -i 's/\r$//' /usr/local/bin/*.py && chmod +x /usr/local/bin/*.py

WORKDIR /workspace

# Blijft draaien, zodat je erin kunt werken met: docker exec -it ifc sh
CMD ["sleep", "infinity"]
